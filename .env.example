# ==============================================
# DATABASE
# ==============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 
# Local PostgreSQL example:
# DATABASE_URL="postgresql://okurmen_user:SecurePass123@localhost:5432/okurmen_db"
#
# Cloud PostgreSQL (Neon, Supabase, etc.) example:
# DATABASE_URL="postgresql://username:password@host.region.provider.com:5432/database?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# ==============================================
# AUTHENTICATION
# ==============================================
# URL of the API server (Next.js backend)
NEXTAUTH_URL="http://localhost:3001"

# Secret key for JWT tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="CHANGE-THIS-TO-RANDOM-SECRET-MIN-32-CHARS"

# ==============================================
# API CONFIGURATION
# ==============================================
# Admin Panel должен знать где находится API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ==============================================
# TELEGRAM BOT (Optional)
# ==============================================
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=""

# Get chat ID from @userinfobot or @get_id_bot
TELEGRAM_CHAT_ID=""

# ==============================================
# ADMIN CREDENTIALS (for seed only)
# ==============================================
# Default admin credentials for initial setup
# IMPORTANT: Change these after first login!
ADMIN_EMAIL="admin@okurmen.kg"
ADMIN_PASSWORD="ChangeThisPassword123!"

# ==============================================
# NOTES
# ==============================================
# 1. NEVER commit .env file to Git
# 2. Use strong passwords in production
# 3. Generate secure NEXTAUTH_SECRET for production
# 4. Keep Telegram tokens secret
# 5. Change admin password after first login
