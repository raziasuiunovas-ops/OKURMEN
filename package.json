{
  "name": "okurmen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @okurmen/database db:generate",
    "db:push": "pnpm --filter @okurmen/database db:push",
    "db:migrate": "pnpm --filter @okurmen/database db:migrate",
    "db:seed": "pnpm --filter @okurmen/database db:seed",
    "db:studio": "pnpm --filter @okurmen/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
