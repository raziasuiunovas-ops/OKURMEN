{
  "name": "okurmen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "npm-run-all --parallel dev:web dev:api dev:admin dev:employee dev:student",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:employee": "cd apps/employee && npm run dev",
    "dev:student": "cd apps/student && npm run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "cd packages/database && pnpm prisma generate",
    "db:push": "cd packages/database && pnpm prisma db push",
    "db:migrate": "cd packages/database && pnpm prisma migrate dev",
    "db:seed": "cd packages/database && pnpm prisma db seed",
    "db:studio": "cd packages/database && pnpm prisma studio",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "setup": "pnpm install && npm run db:setup",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
