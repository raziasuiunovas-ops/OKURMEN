// OKURMEN IT Database Schema
// Based on OKURMEN_DBB.md specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  DROPPED
}

enum EmployeePosition {
  FOUNDER
  TEACHER
  MENTOR
  MANAGER
  DEVELOPER
  SALES
  MARKETING
  SMM
  ADMIN_STAFF
  OTHER
}

enum CourseFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  CONTACTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReviewType {
  STUDENT
  PARENT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum GrantReasonType {
  EMPLOYMENT
  COMMERCIAL_PROJECT
}

enum GrantStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ActivityType {
  ORATORY_COURSE
  SEMINAR
  TALKING_CLUB
  ONUGUU_SABAKTAR
  AI_COURSE
  OTHER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum LanguageCode {
  KY
  RU
  EN
}

// MODELS

model User {
  id                String       @id @default(cuid())
  fullName          String       @map("full_name")
  username          String?      @unique
  phone             String?
  email             String?      @unique
  age               Int?
  studyDuration     String?      @map("study_duration")
  passwordHash      String?      @map("password_hash")
  role              UserRole     @default(CLIENT)
  preferredLanguage LanguageCode @default(RU) @map("preferred_language")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  studentProfile  StudentProfile?
  employeeProfile EmployeeProfile?
  applications    Application[]
  reviews         Review[]

  @@index([email])
  @@index([role])
  @@index([username])
  @@map("users")
}

model StudentProfile {
  id        String        @id @default(cuid())
  userId    String        @unique @map("user_id")
  groupId   String?       @map("group_id")
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group             Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]
  payments          Payment[]
  alumni            Alumni[]
  grants            Grant[]
  courseReviews     CourseReview[]
  lessonProgress    LessonProgress[]
  tokenTransactions TokenTransaction[]
  quizAttempts      QuizAttempt[]
  bookings          Booking[]

  @@index([status])
  @@index([groupId])
  @@map("student_profiles")
}

model EmployeeProfile {
  id         String           @id @default(cuid())
  userId     String           @unique @map("user_id")
  position   EmployeePosition
  bio        String?          @db.Text
  education  String?          @db.Text
  experience String?          @db.Text
  photoUrl   String?          @map("photo_url")
  sortOrder  Int              @default(0) @map("sort_order")
  joinedAt   DateTime?        @map("joined_at")
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseTeachers    CourseTeacher[]
  mentorEnrollments Enrollment[]
  bookings          Booking[]
  mentoredGroup     Group? // One mentor can have one group (1:1 relation)

  @@index([position])
  @@index([isActive])
  @@index([sortOrder])
  @@map("employee_profiles")
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  price            Decimal      @db.Decimal(10, 2)
  duration         String?
  totalHours       Int?         @map("total_hours") // Длительность в часах
  format           CourseFormat @default(HYBRID)
  coverImage       String?      @map("cover_image") // URL фото курса
  coverGradient    String?      @map("cover_gradient") // JSON: {from, to, direction}
  icon             String? // Emoji или название иконки
  rating           Decimal?     @default(0) @db.Decimal(3, 2) // Средний рейтинг 0-5
  totalReviews     Int          @default(0) @map("total_reviews") // Количество оценок
  enrolledStudents Int          @default(0) @map("enrolled_students") // Количество студентов
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  translations   CourseTranslation[]
  teachers       CourseTeacher[]
  enrollments    Enrollment[]
  applications   Application[]
  payments       Payment[]
  groups         Group[]
  courseReviews  CourseReview[]
  reviews        Review[]
  lessons        Lesson[]
  lessonProgress LessonProgress[]
  bookings       Booking[]

  @@index([slug])
  @@index([isActive])
  @@index([rating])
  @@map("courses")
}

model CourseTranslation {
  id           String       @id @default(cuid())
  courseId     String       @map("course_id")
  languageCode LanguageCode @map("language_code")
  title        String
  description  String?      @db.Text
  program      String?      @db.Text
  level        CourseLevel  @default(BEGINNER)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, languageCode])
  @@index([languageCode])
  @@map("course_translations")
}

model CourseTeacher {
  courseId   String @map("course_id")
  employeeId String @map("employee_id")

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([courseId, employeeId])
  @@map("course_teachers")
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String           @map("student_id")
  courseId    String           @map("course_id")
  mentorId    String?          @map("mentor_id")
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  student StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  mentor  EmployeeProfile? @relation(fields: [mentorId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model Application {
  id        String            @id @default(cuid())
  userId    String?           @map("user_id")
  courseId  String            @map("course_id")
  fullName  String            @map("full_name")
  phone     String
  email     String?
  comment   String?           @db.Text
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  course        Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments      Payment[]
  notifications TelegramNotification[]

  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model Payment {
  id                String        @id @default(cuid())
  applicationId     String?       @map("application_id")
  studentId         String?       @map("student_id")
  courseId          String        @map("course_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("KGS")
  provider          String?
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  application   Application?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  student       StudentProfile?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  course        Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  notifications TelegramNotification[]

  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model TelegramNotification {
  id                String             @id @default(cuid())
  paymentId         String?            @map("payment_id")
  applicationId     String?            @map("application_id")
  status            NotificationStatus @default(PENDING)
  telegramMessageId String?            @map("telegram_message_id")
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("telegram_notifications")
}

model Review {
  id         String       @id @default(cuid())
  userId     String?      @map("user_id")
  courseId   String?      @map("course_id")
  authorName String       @map("author_name")
  reviewType ReviewType   @map("review_type")
  text       String       @db.Text
  rating     Int?         @default(5)
  photoUrl   String?      @map("photo_url")
  videoUrl   String?      @map("video_url")
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([courseId])
  @@map("reviews")
}

model Alumni {
  id         String   @id @default(cuid())
  studentId  String?  @map("student_id")
  name       String
  company    String?
  position   String?
  story      String?  @db.Text
  photoUrl   String?  @map("photo_url")
  projects   Json?    @default("[]")
  isFeatured Boolean  @default(false) @map("is_featured")
  createdAt  DateTime @default(now()) @map("created_at")

  student StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([isFeatured])
  @@map("alumni")
}

model Grant {
  id          String          @id @default(cuid())
  studentId   String          @map("student_id")
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("KGS")
  reasonType  GrantReasonType @map("reason_type")
  description String?         @db.Text
  status      GrantStatus     @default(PENDING)
  awardedAt   DateTime?       @map("awarded_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("grants")
}

model Activity {
  id        String       @id @default(cuid())
  slug      String       @unique
  type      ActivityType @default(OTHER)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  translations ActivityTranslation[]

  @@index([slug])
  @@index([isActive])
  @@map("activities")
}

model ActivityTranslation {
  id           String       @id @default(cuid())
  activityId   String       @map("activity_id")
  languageCode LanguageCode @map("language_code")
  title        String
  description  String?      @db.Text

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, languageCode])
  @@map("activity_translations")
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations PageTranslation[]

  @@index([slug])
  @@map("pages")
}

model PageTranslation {
  id           String       @id @default(cuid())
  pageId       String       @map("page_id")
  languageCode LanguageCode @map("language_code")
  title        String
  content      String       @db.Text

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, languageCode])
  @@map("page_translations")
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  url       String
  label     String?
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@index([isActive])
  @@index([sortOrder])
  @@map("social_links")
}

model Media {
  id        String   @id @default(cuid())
  fileUrl   String   @map("file_url")
  fileType  String   @map("file_type")
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}

model TwoFactorCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("two_factor_codes")
}

model Group {
  id          String    @id @default(cuid())
  name        String    @unique // F1, F2, F3, F4, F5
  description String?   @db.Text
  courseId    String?   @map("course_id")
  mentorId    String?   @unique @map("mentor_id") // One group has one mentor (1:1 relation)
  whatsappUrl String?   @map("whatsapp_url")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  course   Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  mentor   EmployeeProfile? @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  students StudentProfile[]

  @@index([name])
  @@index([courseId])
  @@index([mentorId])
  @@index([isActive])
  @@map("groups")
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  studentId String   @map("student_id")
  rating    Int // 1-5 звёзд
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId]) // Один студент = одна оценка курса
  @@index([courseId])
  @@index([rating])
  @@map("course_reviews")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  description String?  @db.Text
  content     String?  @db.Text
  videoUrl    String?  @map("video_url")
  duration    Int? // Длительность в минутах
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
  quizzes        Quiz[]

  @@index([courseId])
  @@index([sortOrder])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  lessonId    String    @map("lesson_id")
  courseId    String    @map("course_id")
  isCompleted Boolean   @default(false) @map("is_completed")
  watchedAt   DateTime? @map("watched_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@index([courseId])
  @@map("lesson_progress")
}

enum TokenTransactionType {
  LESSON_COMPLETED
  QUIZ_PASSED
  STREAK_BONUS
  ACHIEVEMENT
  MANUAL
}

model TokenTransaction {
  id          String               @id @default(cuid())
  studentId   String               @map("student_id")
  amount      Int                  @default(1)
  type        TokenTransactionType
  lessonId    String?              @map("lesson_id")
  description String?              @db.Text
  createdAt   DateTime             @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
  @@index([type])
  @@map("token_transactions")
}

model Quiz {
  id           String   @id @default(cuid())
  lessonId     String   @map("lesson_id")
  title        String
  description  String?  @db.Text
  passingScore Int      @default(70) @map("passing_score") // Минимальный процент для прохождения
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String       @map("quiz_id")
  question      String       @db.Text
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json // Array of options: [{id: string, text: string}]
  correctAnswer Json         @map("correct_answer") // Single id or array of ids
  explanation   String?      @db.Text
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([sortOrder])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String   @map("quiz_id")
  studentId   String   @map("student_id")
  answers     Json // Map questionId -> selectedAnswer(s)
  score       Int // Процент правильных ответов
  isPassed    Boolean  @default(false) @map("is_passed")
  completedAt DateTime @default(now()) @map("completed_at")

  quiz    Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@index([completedAt])
  @@map("quiz_attempts")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id        String        @id @default(cuid())
  studentId String        @map("student_id")
  mentorId  String        @map("mentor_id")
  courseId  String?       @map("course_id")
  date      DateTime
  duration  Int           @default(60) // Длительность в минутах
  status    BookingStatus @default(PENDING)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor  EmployeeProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  course  Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([mentorId])
  @@index([date])
  @@index([status])
  @@map("bookings")
}

model SiteStats {
  id                String   @id @default(cuid())
  totalStudents     Int      @default(0) @map("total_students") // Общее количество студентов за всё время
  employmentRate    Int      @default(0) @map("employment_rate") // Процент трудоустройства
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("site_stats")
}
